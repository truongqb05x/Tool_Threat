<Window x:Class="ThreadsManagerUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ThreadsManagerUI"
        mc:Ignorable="d"
        Title="Phần mềm quản lý tài khoản Threads" Height="700" Width="1200" WindowStartupLocation="CenterScreen" Icon="logo.jpg">
    
    <Window.Resources>
        <Style x:Key="TabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderThickness="0" 
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EAF2FD"/>
                    <Setter Property="Foreground" Value="#1877F2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Background="#F5F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header/Tabs -->
            <RowDefinition Height="*"/>    <!-- Content Area -->
        </Grid.RowDefinitions>

        <!-- Top Menu / Tabs -->
        <Border Grid.Row="0" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Background="White">
            <StackPanel Orientation="Horizontal" Margin="15,10">
                <Button x:Name="BtnTabKetNoi" Style="{StaticResource TabButtonStyle}" Content="Home" Background="#1877F2" Foreground="White" FontWeight="Bold" Click="BtnTabKetNoi_Click"/>
                <Button x:Name="BtnTabDangBai" Style="{StaticResource TabButtonStyle}" Content="Đăng Bài" Click="BtnTabDangBai_Click"/>
                <Button x:Name="BtnTabComment" Style="{StaticResource TabButtonStyle}" Content="Comment Bài Viết" Click="BtnTabComment_Click"/>
                <Button x:Name="BtnTabNuoiTaiKhoan" Style="{StaticResource TabButtonStyle}" Content="Nuôi Tài Khoản" Click="BtnTabNuoiTaiKhoan_Click"/>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            
            <!-- TAB 1: KẾT NỐI THREADS -->
            <Grid x:Name="GridKetNoiThreads" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Sub Header / Filter -->
                    <RowDefinition Height="*"/>    <!-- Main DataGrid -->
                </Grid.RowDefinitions>

                <!-- Toolbar / Filter -->
                <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Lọc:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ComboBox x:Name="CboStatusFilter" Width="120" Margin="0,0,10,0" SelectedIndex="0" SelectionChanged="CboStatusFilter_SelectionChanged">
                            <ComboBoxItem Content="All Status"/>
                            <ComboBoxItem Content="Live"/>
                            <ComboBoxItem Content="Die"/>
                        </ComboBox>
                        
                        <ComboBox Width="120" Margin="0,0,10,0" SelectedIndex="0">
                            <ComboBoxItem Content="All Folder"/>
                        </ComboBox>
                        
                        <TextBlock Text="Tìm kiếm:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                        <TextBox x:Name="TxtSearch" Width="200" VerticalContentAlignment="Center" Margin="0,0,10,0" TextChanged="TxtSearch_TextChanged"/>
                        <Button Content="Tìm" Padding="15,5" Margin="0,0,10,0" Click="BtnSearch_Click"/>
                    </StackPanel>
                </Border>

                <!-- Main Content Area (DataGrid + Sidebar) -->
                <Grid Grid.Row="1" Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="250"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Trạng thái chọn -->
                    <TextBlock x:Name="TxtSelectedCount" Grid.Row="0" Grid.Column="0" Text="Đã chọn: 0" FontWeight="Bold" Margin="0,0,0,5" Foreground="#333"/>

                    <!-- DataGrid -->
                    <ScrollViewer Grid.Row="1" Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <DataGrid x:Name="DgAccounts" ItemsSource="{Binding Accounts}" AutoGenerateColumns="False" CanUserAddRows="False" Background="White" GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderBrush="#E0E0E0" VerticalGridLinesBrush="#EEEEEE" HorizontalGridLinesBrush="#EEEEEE" SelectionChanged="DgAccounts_SelectionChanged">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copy" Click="MenuItem_Copy_Click"/>
                                <MenuItem Header="Mở Chrome" Click="MenuItem_OpenChrome_Click"/>
                                <MenuItem Header="Nuôi Tài Khoản" Click="MenuItem_Nurture_Click"/>
                                <MenuItem Header="Xóa" Click="MenuItem_Delete_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <Setter Property="Background" Value="White"/> 
                                <Setter Property="Foreground" Value="Black"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Live">
                                        <Setter Property="Background" Value="#E6F4EA"/> <!-- Xanh lá nhạt (giống hình) -->
                                    </DataTrigger>
                                      <DataTrigger Binding="{Binding Status}" Value="Die">
                                          <Setter Property="Background" Value="#FCE8E6"/> <!-- Đỏ nhạt -->
                                      </DataTrigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#0078D7"/> <!-- Xanh da trời đậm giống Windows -->
                                        <Setter Property="Foreground" Value="White"/>   <!-- Đổi chữ thành màu trắng để dễ đọc -->
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsMouseOver" Value="True"/>
                                            <Condition Property="IsSelected" Value="False"/>
                                        </MultiTrigger.Conditions>
                                        <Setter Property="Background" Value="#F5F5F5"/> <!-- Màu hover khi không chọn -->
                                    </MultiTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F5F6F8"/>
                                <Setter Property="Foreground" Value="#666666"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="10,12"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="5,5"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="Transparent" SnapsToDevicePixels="True">
                                                <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Chọn" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="50">
                                <DataGridCheckBoxColumn.ElementStyle>
                                    <Style TargetType="CheckBox">
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                        <Setter Property="Margin" Value="10,0,0,0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridCheckBoxColumn.ElementStyle>
                            </DataGridCheckBoxColumn>
                            <DataGridTextColumn Header="STT" Binding="{Binding Index}" Width="50" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                        <Setter Property="Margin" Value="10,0,0,0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Username" Binding="{Binding Uid}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Margin" Value="10,0,0,0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Mật khẩu" Binding="{Binding Password}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Margin" Value="10,0,0,0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="2FA" Binding="{Binding TwoFA}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Margin" Value="10,0,0,0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Cookie_Instagram" Binding="{Binding Cookie}" Width="250">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Margin" Value="10,0,0,0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Cookie_Threads" Binding="{Binding CookieThreads}" Width="250">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Margin" Value="10,0,0,0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Proxy" Binding="{Binding Proxy}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Margin" Value="10,0,0,0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="*" MinWidth="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Margin" Value="10,0,0,0"/>
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    </ScrollViewer>

                    <!-- Right Sidebar -->
                    <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="10,0,0,0">
                        <!-- Action Buttons -->
                        <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" Padding="10" Margin="0,0,0,15">
                            <StackPanel>
                                <Button Content="Thêm Tài Khoản" Padding="10" Margin="0,0,0,10" Background="White" BorderBrush="#CCCCCC" Click="BtnImportAccount_Click"/>
                                <Button Content="Import Từ File" Padding="10" Margin="0,0,0,10" Background="White" BorderBrush="#CCCCCC" Click="BtnImportFromFile_Click"/>
                                <Button Content="⚙ Cài đặt" Padding="10" Background="White" BorderBrush="#1877F2" Foreground="#1877F2" Click="BtnSettings_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Statistics -->
                        <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" Padding="15">
                            <StackPanel>
                                <TextBlock Text="Thống kê thư mục" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>
                                
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Live" Foreground="#757575"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LiveAccounts}" FontWeight="Bold" Foreground="#1877F2"/>
                                </Grid>
                                
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Die / Spam" Foreground="#757575"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DeadAccounts}" FontWeight="Bold" Foreground="#E53935"/>
                                </Grid>
                                
                                <Separator Margin="0,0,0,10"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Tổng tài khoản" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TotalAccounts}" FontWeight="Bold" Foreground="#E53935"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- TAB 2: ĐĂNG BÀI (POST) -->
            <Grid x:Name="GridDangBai" Visibility="Collapsed" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="350"/> <!-- Cột trái: chọn account -->
                    <ColumnDefinition Width="*"/>   <!-- Cột phải: cấu hình -->
                </Grid.ColumnDefinitions>

                <!-- Cột trái: Chọn tài khoản -->
                <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Margin="10">
                            <Button Content="Chọn Tài Khoản" Background="#1877F2" Foreground="White" FontWeight="Bold" Padding="10" Click="BtnSelectAccountsForPost_Click" BorderThickness="0"/>
                            <TextBlock Text="Danh sách tài khoản chờ đăng:" Margin="0,15,0,5" FontWeight="SemiBold" Foreground="#555"/>
                        </StackPanel>

                        <!-- Danh sách account chạy -->
                        <DataGrid x:Name="DgPostAccounts" Grid.Row="1" ItemsSource="{Binding SelectedAccountsForPost}" AutoGenerateColumns="False" CanUserAddRows="False" Background="White" GridLinesVisibility="All" HeadersVisibility="Column" BorderBrush="#E0E0E0" VerticalGridLinesBrush="#EEEEEE" HorizontalGridLinesBrush="#EEEEEE" BorderThickness="0,1,0,0">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F5F6F8"/>
                                    <Setter Property="Foreground" Value="#666666"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="5,5"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STT" Binding="{Binding Index}" Width="50" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Username" Binding="{Binding Uid}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Quá trình" Binding="{Binding PostProcessStatus}" Width="80" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="#1877F2"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PostProcessStatus}" Value="Xong">
                                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PostProcessStatus}" Value="Die">
                                                    <Setter Property="Foreground" Value="#F44336"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Xóa" Foreground="Red" Background="Transparent" BorderThickness="0" Click="BtnRemovePostAccount_Click" ToolTip="Xóa khỏi danh sách chờ"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Cột phải: Cấu hình đăng bài và Log -->
                <Border Grid.Column="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Cấu hình -->
                            <RowDefinition Height="Auto"/> <!-- Nút điều khiển -->
                            <RowDefinition Height="*"/>    <!-- Box Log -->
                        </Grid.RowDefinitions>

                        <!-- Panel Cấu hình -->
                        <StackPanel Grid.Row="0" Margin="15">
                            <TextBlock Text="Nguồn nội dung:" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#333"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <RadioButton x:Name="RbSourceExcel" Content="Nhập từ file Excel/Txt" IsChecked="True" Margin="0,0,15,0" Checked="RbSourceExcel_Checked"/>
                                <RadioButton x:Name="RbSourceGemini" Content="Tạo bằng Gemini" Checked="RbSourceGemini_Checked"/>
                            </StackPanel>

                            <!-- Panel Excel -->
                            <StackPanel x:Name="PanelExcel" Visibility="Visible">
                                <TextBlock Text="File Excel/Txt nội dung:" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#333"/>
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtExcelPath" Padding="8" BorderBrush="#CCCCCC" Background="#F5F5F5" Grid.Column="0"/>
                                    <Button Content="Chọn file" Grid.Column="1" Margin="5,0,0,0" Padding="15,0" Click="BtnSelectExcel_Click"/>
                                </Grid>
                            </StackPanel>

                            <!-- Panel Gemini -->
                            <StackPanel x:Name="PanelGemini" Visibility="Collapsed">
                                <TextBlock Text="Gemini API Key:" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#333"/>
                                <TextBox x:Name="TxtGeminiKey" Padding="8" BorderBrush="#CCCCCC" Background="#F5F5F5" Margin="0,0,0,10"/>
                                <TextBlock Text="Chủ đề / Prompt cho Gemini:" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#333"/>
                                <TextBox x:Name="TxtGeminiPrompt" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="80" Padding="10" BorderBrush="#CCCCCC" Margin="0,0,0,15" Background="#F5F5F5"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Cột Hình ảnh/Video -->
                                <StackPanel Grid.Column="0">
                                    <CheckBox x:Name="ChkUseMedia" Content="Kèm Hình ảnh/Video:" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#333" IsChecked="False"/>
                                    <Grid IsEnabled="{Binding IsChecked, ElementName=ChkUseMedia}">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Opacity" Value="1.0" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Opacity" Value="0.5" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtMediaPath" Height="60" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8" BorderBrush="#CCCCCC" Background="#F5F5F5" Grid.Column="0"/>
                                        <Button Content="Chọn" Grid.Column="1" Margin="5,0,0,0" Padding="15,0" Click="BtnSelectMedia_Click"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Cột Hashtag -->
                                <StackPanel Grid.Column="2">
                                    <CheckBox x:Name="ChkUseHashtag" Content="Thêm Hashtag:" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#333" IsChecked="False"/>
                                    <Border IsEnabled="{Binding IsChecked, ElementName=ChkUseHashtag}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Opacity" Value="1.0" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Opacity" Value="0.5" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBox x:Name="TxtHashtags" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="60" Padding="10" BorderBrush="#CCCCCC" Background="#F5F5F5"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Khoảng cách giữa 2 bài đăng:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0" Foreground="#333"/>
                                <TextBox x:Name="TxtDelayMin" Text="10" Width="40" Padding="5" TextAlignment="Center"/>
                                <TextBlock Text="đến" VerticalAlignment="Center" Margin="5,0"/>
                                <TextBox x:Name="TxtDelayMax" Text="20" Width="40" Padding="5" TextAlignment="Center"/>
                                <TextBlock Text="giây" VerticalAlignment="Center" Margin="5,0"/>
                                
                                <TextBlock Text="|" VerticalAlignment="Center" Margin="15,0" Foreground="#CCCCCC" FontWeight="Bold"/>

                                <TextBlock Text="Số luồng (Threads):" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0" Foreground="#333"/>
                                <TextBox x:Name="TxtThreadCount" Text="1" Width="40" Padding="5" TextAlignment="Center"/>

                                <TextBlock Text="|" VerticalAlignment="Center" Margin="15,0" Foreground="#CCCCCC" FontWeight="Bold"/>
                                
                                <CheckBox x:Name="ChkPostLoop" Content="Lặp lại danh sách:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#333"/>
                                <TextBox x:Name="TxtPostLoopCount" Text="1" Width="40" Padding="5" TextAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=ChkPostLoop}"/>
                                <TextBlock Text="lần" VerticalAlignment="Center" Margin="5,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Thanh điều khiển -->
                        <Border Grid.Row="1" Background="#F5F6F8" BorderBrush="#E0E0E0" BorderThickness="0,1,0,1" Padding="15,10">
                            <Grid>
                                <!-- Phần hiển thị Progress -->
                                <StackPanel x:Name="PanelProgress" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed">
                                    <ProgressBar IsIndeterminate="True" Width="20" Height="20" Margin="0,0,10,0" Foreground="#1877F2" Background="Transparent"/>
                                    <TextBlock x:Name="TxtPostProgress" Text="Đang chạy: 0/0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#1877F2"/>
                                </StackPanel>
                                
                                <!-- Nút chức năng -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="BtnStartPost" Content="▶ Chạy Đăng Bài" Background="#4CAF50" Foreground="White" FontWeight="Bold" Padding="20,10" Margin="0,0,10,0" BorderThickness="0" Click="BtnStartPost_Click"/>
                                    <Button x:Name="BtnStopPost" Content="⏹ Dừng Lại" Background="#F44336" Foreground="White" FontWeight="Bold" Padding="20,10" BorderThickness="0" Click="BtnStopPost_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Box Logs -->
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Nhật ký hoạt động (Logs):" FontWeight="SemiBold" Margin="15,10,0,5" Foreground="#555"/>
                            <TextBox x:Name="TxtLogs" Grid.Row="1" Background="White" Foreground="Black" BorderBrush="#CCCCCC" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="15,0,15,15" Padding="10"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
            
            <!-- TAB 4: COMMENT BÀI VIẾT -->
            <Grid x:Name="GridComment" Visibility="Collapsed" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="350"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Cột trái: Chọn tài khoản -->
                <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Margin="10">
                            <Button Content="Chọn Tài Khoản" Background="#1877F2" Foreground="White" FontWeight="Bold" Padding="10" BorderThickness="0" Click="BtnSelectAccountsForComment_Click"/>
                            <TextBlock Text="Danh sách tài khoản chờ comment:" Margin="0,15,0,5" FontWeight="SemiBold" Foreground="#555"/>
                        </StackPanel>

                        <!-- Danh sách account chạy comment -->
                        <DataGrid x:Name="DgCommentAccounts" Grid.Row="1" ItemsSource="{Binding SelectedAccountsForComment}" AutoGenerateColumns="False" CanUserAddRows="False" Background="White" GridLinesVisibility="All" HeadersVisibility="Column" BorderBrush="#E0E0E0" VerticalGridLinesBrush="#EEEEEE" HorizontalGridLinesBrush="#EEEEEE" BorderThickness="0,1,0,0">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F5F6F8"/>
                                    <Setter Property="Foreground" Value="#666666"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="5,5"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STT" Binding="{Binding Index}" Width="50" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Username" Binding="{Binding Uid}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Quá trình" Binding="{Binding PostProcessStatus}" Width="80" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="#1877F2"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PostProcessStatus}" Value="Xong">
                                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PostProcessStatus}" Value="Die">
                                                    <Setter Property="Foreground" Value="#F44336"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Xóa" Foreground="Red" Background="Transparent" BorderThickness="0" ToolTip="Xóa khỏi danh sách chờ" Click="BtnRemoveCommentAccount_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Cột phải: Cấu hình và Log -->
                <Border Grid.Column="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Panel Cấu hình -->
                        <StackPanel Grid.Row="0" Margin="15">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <TextBlock Text="Khoảng cách giữa 2 lần comment:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0" Foreground="#333"/>
                                <TextBox x:Name="TxtCommentDelayMin" Text="10" Width="40" Padding="5" TextAlignment="Center"/>
                                <TextBlock Text="đến" VerticalAlignment="Center" Margin="5,0"/>
                                <TextBox x:Name="TxtCommentDelayMax" Text="20" Width="40" Padding="5" TextAlignment="Center"/>
                                <TextBlock Text="giây" VerticalAlignment="Center" Margin="5,0"/>

                                <TextBlock Text="|" VerticalAlignment="Center" Margin="15,0" Foreground="#CCCCCC" FontWeight="Bold"/>

                                <TextBlock Text="Số luồng (Threads):" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0" Foreground="#333"/>
                                <TextBox x:Name="TxtCommentThreadCount" Text="1" Width="40" Padding="5" TextAlignment="Center"/>

                                <TextBlock Text="|" VerticalAlignment="Center" Margin="15,0" Foreground="#CCCCCC" FontWeight="Bold"/>

                                <TextBlock Text="Số bài comment/acc:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0" Foreground="#333"/>
                                <TextBox x:Name="TxtCommentNum" Text="1" Width="40" Padding="5" TextAlignment="Center"/>

                                <TextBlock Text="|" VerticalAlignment="Center" Margin="15,0" Foreground="#CCCCCC" FontWeight="Bold"/>
                                
                                <CheckBox x:Name="ChkCommentLoop" Content="Lặp lại danh sách:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#333"/>
                                <TextBox x:Name="TxtCommentLoopCount" Text="1" Width="40" Padding="5" TextAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=ChkCommentLoop}"/>
                                <TextBlock Text="lần" VerticalAlignment="Center" Margin="5,0"/>
                            </StackPanel>
                            
                            <TextBlock Text="Chế độ Comment:" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#333"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <RadioButton x:Name="RbCommentNewfeed" Content="Comment Newfeed" IsChecked="True" Margin="0,0,15,0"/>
                                <RadioButton x:Name="RbCommentTrending" Content="Comment theo bài thịnh hành"/>
                            </StackPanel>
                            


                            <TextBlock Text="File nội dung comment (.xlsx/.txt):" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#333"/>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtCommentExcelPath" Grid.Column="0" IsReadOnly="True" Background="#F9F9F9" Padding="5,0"/>
                                <Button Grid.Column="1" Content="Chọn File" Margin="10,0,0,0" Click="BtnSelectCommentExcel_Click"/>
                            </Grid>
                            
                            <CheckBox x:Name="ChkCommentUseMedia" Content="Kèm Hình Ảnh/Video:" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#333" Checked="ChkCommentUseMedia_Checked" Unchecked="ChkCommentUseMedia_Unchecked"/>
                            <Grid x:Name="PanelCommentMedia" Visibility="Collapsed" Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtCommentMediaPath" Grid.Column="0" IsReadOnly="True" Background="#F9F9F9" Padding="5,0"/>
                                <Button Grid.Column="1" Content="Chọn File" Margin="10,0,0,0" Click="BtnSelectCommentMedia_Click"/>
                            </Grid>
                            

                        </StackPanel>

                        <!-- Thanh điều khiển -->
                        <Border Grid.Row="1" Background="#F5F6F8" BorderBrush="#E0E0E0" BorderThickness="0,1,0,1" Padding="15,10">
                            <Grid>
                                <!-- Phần hiển thị Progress -->
                                <StackPanel x:Name="PanelProgressComment" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed">
                                    <ProgressBar IsIndeterminate="True" Width="20" Height="20" Margin="0,0,10,0" Foreground="#1877F2" Background="Transparent"/>
                                    <TextBlock x:Name="TxtCommentProgress" Text="Đang chạy: 0/0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#1877F2"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="BtnStartComment" Content="▶ Chạy Comment" Background="#4CAF50" Foreground="White" FontWeight="Bold" Padding="20,10" Margin="0,0,10,0" BorderThickness="0" Click="BtnStartComment_Click"/>
                                    <Button x:Name="BtnStopComment" Content="⏹ Dừng Lại" Background="#F44336" Foreground="White" FontWeight="Bold" Padding="20,10" BorderThickness="0" Click="BtnStopComment_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Box Logs -->
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Nhật ký hoạt động (Logs):" FontWeight="SemiBold" Margin="15,10,0,5" Foreground="#555"/>
                            <TextBox x:Name="TxtLogsComment" Grid.Row="1" Background="White" Foreground="Black" BorderBrush="#CCCCCC" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="15,0,15,15" Padding="10"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
            
            <!-- TAB 5: NUÔI TÀI KHOẢN -->
            <Grid x:Name="GridNuoiTaiKhoan" Visibility="Collapsed" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="350"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Cột trái: Chọn tài khoản -->
                <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Margin="10">
                            <Button Content="Chọn Tài Khoản" Background="#1877F2" Foreground="White" FontWeight="Bold" Padding="10" Click="BtnSelectAccountsForNurture_Click" BorderThickness="0"/>
                            <TextBlock Text="Danh sách tài khoản chờ chạy:" Margin="0,15,0,5" FontWeight="SemiBold" Foreground="#555"/>
                        </StackPanel>

                        <!-- Danh sách account chạy -->
                        <DataGrid x:Name="DgNurtureAccounts" Grid.Row="1" ItemsSource="{Binding SelectedAccountsForNurture}" AutoGenerateColumns="False" CanUserAddRows="False" Background="White" GridLinesVisibility="All" HeadersVisibility="Column" BorderBrush="#E0E0E0" VerticalGridLinesBrush="#EEEEEE" HorizontalGridLinesBrush="#EEEEEE" BorderThickness="0,1,0,0">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F5F6F8"/>
                                    <Setter Property="Foreground" Value="#666666"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="5,5"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STT" Binding="{Binding Index}" Width="50" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Username" Binding="{Binding Uid}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Quá trình" Binding="{Binding PostProcessStatus}" Width="80" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="#1877F2"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PostProcessStatus}" Value="Xong">
                                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PostProcessStatus}" Value="Die">
                                                    <Setter Property="Foreground" Value="#F44336"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Xóa" Foreground="Red" Background="Transparent" BorderThickness="0" Click="BtnRemoveNurtureAccount_Click" ToolTip="Xóa khỏi danh sách chờ"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Cột phải: Cấu hình và Log -->
                <Border Grid.Column="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Panel Cấu hình -->
                        <StackPanel Grid.Row="0" Margin="15">
                            <TextBlock Text="Cấu hình Nuôi tài khoản:" FontWeight="SemiBold" Margin="0,0,0,15" Foreground="#333" FontSize="16"/>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Lướt Newfeed -->
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <CheckBox x:Name="ChkScrollNewsfeed" Content="Lướt Newfeed" FontWeight="Bold" Margin="0,0,0,5" IsChecked="True"/>
                                    <StackPanel Margin="20,0,0,0" IsEnabled="{Binding IsChecked, ElementName=ChkScrollNewsfeed}">
                                        <CheckBox x:Name="ChkLikePost" Content="Thả tym bài viết ngẫu nhiên" Margin="0,5,0,5" IsChecked="True"/>
                                        <StackPanel Orientation="Horizontal" Margin="20,0,0,0" IsEnabled="{Binding IsChecked, ElementName=ChkLikePost}">
                                            <TextBlock Text="Delay:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBox x:Name="TxtLikeDelayMin" Text="10" Width="30" Padding="5" TextAlignment="Center"/>
                                            <TextBlock Text="đến" VerticalAlignment="Center" Margin="5,0"/>
                                            <TextBox x:Name="TxtLikeDelayMax" Text="30" Width="30" Padding="5" TextAlignment="Center"/>
                                            <TextBlock Text="giây" VerticalAlignment="Center" Margin="5,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Đọc thông báo -->
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <CheckBox x:Name="ChkReadNotifications" Content="Đọc thông báo" FontWeight="Bold" Margin="0,0,0,5" IsChecked="True"/>
                                    <StackPanel Margin="20,0,0,0" IsEnabled="{Binding IsChecked, ElementName=ChkReadNotifications}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Số lượng cần đọc:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBox x:Name="TxtNotificationCount" Text="2" Width="40" Padding="5" TextAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!-- Tổng thời gian và số luồng -->
                            <Border BorderBrush="#EEEEEE" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Tổng thời gian nuôi (phút):" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0" Foreground="#333"/>
                                    <TextBox x:Name="TxtTotalNurtureMinutes" Text="30" Width="40" Padding="5" TextAlignment="Center"/>
                                    
                                    <TextBlock Text="|" VerticalAlignment="Center" Margin="15,0" Foreground="#CCCCCC" FontWeight="Bold"/>

                                    <TextBlock Text="Số luồng (Threads):" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0" Foreground="#333"/>
                                    <TextBox x:Name="TxtNurtureThreadCount" Text="1" Width="40" Padding="5" TextAlignment="Center"/>

                                    <TextBlock Text="|" VerticalAlignment="Center" Margin="15,0" Foreground="#CCCCCC" FontWeight="Bold"/>
                                    
                                    <CheckBox x:Name="ChkNurtureLoop" Content="Lặp lại danh sách:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#333"/>
                                    <TextBox x:Name="TxtNurtureLoopCount" Text="1" Width="40" Padding="5" TextAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=ChkNurtureLoop}"/>
                                    <TextBlock Text="lần" VerticalAlignment="Center" Margin="5,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Thanh điều khiển -->
                        <Border Grid.Row="1" Background="#F5F6F8" BorderBrush="#E0E0E0" BorderThickness="0,1,0,1" Padding="15,10">
                            <Grid>
                                <StackPanel x:Name="PanelProgressNurture" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed">
                                    <ProgressBar IsIndeterminate="True" Width="20" Height="20" Margin="0,0,10,0" Foreground="#1877F2" Background="Transparent"/>
                                    <TextBlock x:Name="TxtNurtureProgress" Text="Đang chạy: 0/0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#1877F2"/>
                                </StackPanel>
                                
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="BtnStartNurture" Content="▶ Chạy Nuôi Tài Khoản" Background="#4CAF50" Foreground="White" FontWeight="Bold" Padding="20,10" Margin="0,0,10,0" BorderThickness="0" Click="BtnStartNurture_Click"/>
                                    <Button x:Name="BtnStopNurture" Content="⏹ Dừng Lại" Background="#F44336" Foreground="White" FontWeight="Bold" Padding="20,10" BorderThickness="0" Click="BtnStopNurture_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Box Logs -->
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Nhật ký hoạt động (Logs):" FontWeight="SemiBold" Margin="15,10,0,5" Foreground="#555"/>
                            <TextBox x:Name="TxtNurtureLogs" Grid.Row="1" Background="White" Foreground="Black" BorderBrush="#CCCCCC" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="15,0,15,15" Padding="10"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Loading Overlay -->
        <Border x:Name="LoadingOverlay" Grid.RowSpan="2" Background="#80000000" Visibility="Collapsed">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="White" Padding="30,20" CornerRadius="8">
                <StackPanel>
                    <ProgressBar IsIndeterminate="True" Width="200" Height="20" Margin="0,0,0,15" Foreground="#1877F2"/>
                    <TextBlock x:Name="TxtLoadingStatus" Text="Đang khởi động Chrome..." FontWeight="Bold" FontSize="16" Foreground="#333" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
