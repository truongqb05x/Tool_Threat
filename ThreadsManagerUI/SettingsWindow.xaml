<Window x:Class="ThreadsManagerUI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cài đặt hệ thống" Height="380" Width="450" WindowStartupLocation="CenterOwner" Background="White" Icon="logo.jpg">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <TextBlock Grid.Row="0" Text="Cấu hình hệ thống" FontWeight="Bold" FontSize="18" Foreground="#333" Margin="0,0,0,20"/>

        <!-- Đường dẫn Profile -->
        <TextBlock Grid.Row="1" Text="Đường dẫn profile:" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#555"/>
        <TextBox x:Name="TxtProfilePath" Grid.Row="2" Padding="8" Margin="0,0,0,15" BorderBrush="#CCCCCC" Background="#F5F5F5"/>

        <!-- Tùy chọn Proxy -->
        <TextBlock Grid.Row="3" Text="Chọn loại Proxy:" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#555"/>
        <StackPanel Grid.Row="4" Margin="0,0,0,15">
            <ComboBox x:Name="CboProxyType" Padding="8" BorderBrush="#CCCCCC" SelectedIndex="0" SelectionChanged="CboProxyType_SelectionChanged">
                <ComboBoxItem Content="Không dùng"/>
                <ComboBoxItem Content="Proxy tĩnh"/>
            </ComboBox>
            <Button x:Name="BtnImportProxy" Content="Import Proxy" HorizontalAlignment="Left" Padding="15,5" Background="#4CAF50" Foreground="White" BorderBrush="Transparent" Cursor="Hand" Margin="0,10,0,0" Visibility="Collapsed" Click="BtnImportProxy_Click"/>
        </StackPanel>

        <!-- Phương thức Đăng nhập -->
        <TextBlock Grid.Row="5" Text="Phương thức đăng nhập:" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#555"/>
        <ComboBox x:Name="CboLoginMethod" Grid.Row="6" Padding="8" Margin="0,0,0,15" BorderBrush="#CCCCCC" SelectedIndex="0">
            <ComboBoxItem Content="Bằng Cookie (Ưu tiên)"/>
            <ComboBoxItem Content="Bằng User/Pass"/>
        </ComboBox>

        <!-- Tự động lấy Cookie Threads -->
        <CheckBox x:Name="ChkAutoGetCookieThreads" Grid.Row="7" VerticalAlignment="Top" Margin="0,5,0,15" Content="Tự động lấy Cookie Threads khi chạy" FontWeight="SemiBold" Foreground="#555"/>

        <!-- Nút Lưu -->
        <Button Grid.Row="8" Content="Lưu Cài Đặt" HorizontalAlignment="Right" Padding="30,8" Background="#1877F2" Foreground="White" BorderBrush="Transparent" Cursor="Hand" Click="BtnSave_Click"/>
    </Grid>
</Window>
